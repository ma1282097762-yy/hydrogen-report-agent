# 可研报告生成 Agent 后端配置样例（不含真实密钥）
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，不会进仓库。

# —— 模型（DeepSeek，OpenAI 兼容）——
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=3

# —— 数据与文件 ——
DATA_DIR=data
UPLOAD_MAX_BYTES=104857600
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_TARGET_WORDS=18000
DEFAULT_TARGET_WORDS=12000
